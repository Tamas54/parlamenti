# Parlamentaris Kompendium MCP — környezeti változók
#
# Railway-en ezek környezeti változókként állíthatók be.
# Lokálisan: cp .env.example .env

# Szerver
HOST=0.0.0.0
PORT=8000

# Embedding modell (Sprint 3-ban aktiválódik)
# Alapértelmezett: multilingual MiniLM (kicsi, gyors, jó magyar)
# EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Logging szint
LOG_LEVEL=INFO

# Echolot-mintájú ingyenes proxyrotáció parlament.hu lekérésekhez.
# Direkt kapcsolat az első; blokknál célhoz ellenőrzött HTTP CONNECT proxyk.
PARL_PROXY_POOL=1
# PARL_PROXY_POOL_URL=https://raw.githubusercontent.com/iplocate/free-proxy-list/main/all-proxies.txt
# Az ECHOLOT_PROXY_POOL / ECHOLOT_PROXY_POOL_URL neveket is elfogadja,
# ha a PARL_ változat nincs beállítva. Nincs fizetős proxy vagy API-kulcs.
